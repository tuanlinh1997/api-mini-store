# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=log
# Set true when running behind a reverse proxy (so client IP / throttling use X-Forwarded-For)
TRUST_PROXY=false
# Comma-separated list of allowed browser origins. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true

# --- Database (MySQL 8) ---
DATABASE_URL="mysql://root:@127.0.0.1:3306/mini_store"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Session housekeeping ---
# Daily purge of sessions that expired or were revoked more than N days ago.
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_CRON="0 3 * * *"
SESSION_RETENTION_DAYS=30

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
LOGIN_THROTTLE_TTL_SECONDS=60
LOGIN_THROTTLE_LIMIT=5

# --- Business rules (SRS open questions, see docs/architecture/DECISIONS.md) ---
MAX_DISCOUNT_PERCENT_CASHIER=10
MAX_DISCOUNT_PERCENT_ADMIN=100
POINTS_PER_VND=10000

# --- Receipt ---
STORE_NAME="Siêu thị mini"
STORE_ADDRESS=
STORE_PHONE=

# --- Seed (used only by `npm run prisma:seed`; example values, change them) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
SEED_DEMO_PASSWORD=ChangeMe-Demo-123

# --- Backup (npm run db:backup / db:restore) ---
BACKUP_DIR=./backups
# Number of most recent backups to keep
BACKUP_RETENTION_COUNT=14
# Only needed when mysqldump / mysql are not on PATH (e.g. Laragon on Windows)
# MYSQLDUMP_PATH=C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysqldump.exe
# MYSQL_PATH=C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysql.exe
